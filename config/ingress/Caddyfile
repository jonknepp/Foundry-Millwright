			forward_auth middleware:8080 {
				uri /api/authorize/foundry
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}

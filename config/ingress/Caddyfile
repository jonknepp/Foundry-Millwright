{
	default_sni {$MILLWRIGHT_LAN_IP}

	order authenticate before respond
	order authorize before reverse_proxy

	security {
		oauth identity provider discord {
			realm discord
			driver discord
			client_id {env.DISCORD_CLIENT_ID}
			client_secret {file./run/secrets/discord-client-secret}
			scopes identify guilds guilds.members.read
			user_group_filters ^{$DISCORD_GUILD_ID}$
		}

		authentication portal millwright_portal {
			enable identity provider discord

			crypto default token lifetime {$MILLWRIGHT_AUTH_TOKEN_LIFETIME}
			crypto key sign-verify {file./run/secrets/authcrunch-signing-key}

			trust login redirect uri domain exact {$MILLWRIGHT_PUBLIC_HOSTNAME} path prefix /
			trust login redirect uri domain exact {$MILLWRIGHT_LAN_IP} path prefix /
			trust login redirect uri domain exact localhost path prefix /

			transform user {
				match realm discord
				action add role authp/user
				action add role millwright/authenticated
			}
		}

		authorization policy millwright_policy {
			set auth url /auth/

			crypto default token lifetime {$MILLWRIGHT_AUTH_TOKEN_LIFETIME}
			crypto key verify {file./run/secrets/authcrunch-signing-key}

			allow roles millwright/authenticated

			# AuthCrunch overwrites this identity header with the verified JWT subject.
			inject header X-Millwright-Subject from sub
		}
	}
}

{$MILLWRIGHT_PUBLIC_HOSTNAME}:443 {
	tls {
		dns duckdns {file./run/secrets/duckdns-token}
	}

	# Serve upstream failure pages locally, even when middleware is offline.
	handle_errors {
		@badGateway expression {err.status_code} == 502
		handle @badGateway {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Foundry temporarily unavailable</title><style>body{font:1rem/1.6 system-ui,sans-serif;background:#151923;color:#f1f3f8;min-height:100vh;display:grid;place-items:center;margin:0;padding:1rem;box-sizing:border-box}main{max-width:34rem;padding:2rem;background:#232936;border-radius:12px}h1{font-size:1.6rem;line-height:1.3}p{color:#d1d6e1}</style></head><body><main><h1>Foundry is temporarily unavailable</h1><p>We couldn't connect to the game service right now. Please contact your Game Master for assistance.</p><p>You can try again in a few minutes.</p><script>if(!location.pathname.startsWith("/millwright/"))location.replace("/millwright/connect");</script></main></body></html>` 502
		}
		respond "Service unavailable" {err.status_code}
	}

	# Redirect the unused authentication portal dashboard to Millwright.
	@portal path /auth/portal
	redir @portal / 302

	# Discord authentication endpoints.
	@auth path /auth/*
	route @auth {
		authenticate with millwright_portal
	}

	# Protect both Foundry and middleware with the existing OAuth2 policy.
	# Middleware is enabled separately; Caddy must not route to it until started.
	# Authentication is enforced on application routes; the root redirect
	# is an explicit entry-point redirect rather than an AuthCrunch response.
	@millwrightRoot path /
	redir @millwrightRoot /millwright/ 302

	route {
		authorize with millwright_policy
		# Foundry may navigate browsers to /no during shutdown; do not proxy it.
		@foundryUnavailable {
			method GET HEAD
			path /no /no/
		}
		handle @foundryUnavailable {
			redir * /millwright/connect 302
		}
		handle_path /millwright/* {
			reverse_proxy middleware:8080 {
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
		}
		# Setup HTML is injected by middleware; other setup requests remain direct.
		@foundrySetupPage {
			method GET
			path /setup
		}
		handle @foundrySetupPage {
			forward_auth middleware:8080 {
				uri /api/authorize/foundry
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
			rewrite * /api/foundry-setup-page
			reverse_proxy middleware:8080 {
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
		}
		# Only Foundry login HTML GETs pass through Millwright for button injection.
		# All form POSTs, websocket traffic and game assets remain direct.
		@foundryLoginPages {
			method GET
			path /join /auth
		}
		handle @foundryLoginPages {
			forward_auth middleware:8080 {
				uri /api/authorize/foundry
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
			vars millwright_login_page {http.request.uri.path}
			rewrite * /api/foundry-login-page
			reverse_proxy middleware:8080 {
				header_up X-Millwright-Page {http.vars.millwright_login_page}
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
		}
		handle {
			# Forward only authorization decisions through middleware;
			# Foundry traffic continues directly to its upstream.
			forward_auth middleware:8080 {
				uri /api/authorize/foundry
				header_up X-Millwright-Subject {http.request.header.X-Millwright-Subject}
				header_up X-Millwright-Proxy-Key {file./run/secrets/middleware-proxy-key}
			}
			reverse_proxy foundry:30000
		}
	}
}

https://{$MILLWRIGHT_LAN_IP}:443, https://localhost:443 {
	tls internal

	# Serve upstream failure pages locally, even when middleware is offline.
	handle_errors {
		@badGateway expression {err.status_code} == 502
		handle @badGateway {

# =============================================================================
# Millwright - Environment Configuration
# =============================================================================

# Millwright persistent storage
# Windows example: F:/GameNight/Millwright
# Initialized by scripts/Initialize-Millwright.ps1; persistent .env is authoritative.
MILLWRIGHT_DATA_DIR=F:/GameNight/Millwright

# Foundry distribution archive
# The initializer copies the selected Node.js ZIP into persistent sources/ and sets this path.
FOUNDRY_ARCHIVE=

# Local Foundry access
FOUNDRY_PORT=30000

# Caddyfile source (optional)
# Defaults to the installer-managed file under MILLWRIGHT_DATA_DIR/config/ingress.
# For a repository checkout, set ./config/ingress/Caddyfile to use the project file directly.
MILLWRIGHT_CADDYFILE=

# HTTPS ingress configuration
MILLWRIGHT_HTTPS_BIND_ADDRESS=0.0.0.0
MILLWRIGHT_HTTPS_PORT=8443
MILLWRIGHT_PUBLIC_HOSTNAME=your-foundry.duckdns.org
# LAN IPv4 address of the Docker host
MILLWRIGHT_LAN_IP=192.168.1.100

# Dynamic DNS configuration
MILLWRIGHT_DNS_PROVIDER=duckdns

# Port forwarding
# Set to the mode supported by your deployment (for example, upnp).
MILLWRIGHT_PORT_FORWARDING_MODE=upnp
# Public-facing HTTPS port; may differ from the local listener port.
MILLWRIGHT_PUBLIC_HTTPS_PORT=8443
# Windows network adapter interface index (check Get-NetIPInterface).
MILLWRIGHT_NETWORK_INTERFACE_INDEX=

# =============================================================================
# Discord OAuth2 and Authorization
# =============================================================================

# Discord application client ID
DISCORD_CLIENT_ID=

# Discord application client secret
# Path to a file containing the secret.
DISCORD_CLIENT_SECRET_FILE=

# Discord bot token
# Used for supported Discord member lookups; no persistent bot process.
# No persistent runtime bot is required.
DISCORD_BOT_TOKEN_FILE=

# Populated by Set-DiscordConfig.ps1
# Discord server (guild) ID
DISCORD_GUILD_ID=


# =============================================================================
# Caddy Security
# =============================================================================

# JWT lifetime in seconds.
# Default: 604800 (7 days).
#
# Discord OAuth2 authentication is required when the JWT expires.
# Token expiry requires fresh authentication; access is controlled by world account mappings.
MILLWRIGHT_AUTH_TOKEN_LIFETIME=604800